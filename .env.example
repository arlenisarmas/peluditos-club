# Dominio público del sitio: lo usan metadata, Open Graph, sitemap, robots,
# JSON-LD y las URLs canónicas. En local podés dejarlo sin definir — se cae a
# NEXTAUTH_URL y, si tampoco está, a http://localhost:3000. En producción
# (Vercel u otro hosting) configurá esta variable con el dominio real.
NEXT_PUBLIC_SITE_URL="https://chepeludos.shop"

# Fase 2 — Base de datos (PostgreSQL + Prisma). Requerida.
# Si instalaste PostgreSQL local con winget (ver README), el usuario/contraseña
# por defecto son postgres/postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peluditos_club?schema=public"

# Fase 3 — Autenticación (NextAuth) y usuario admin. Requeridas.
NEXTAUTH_URL="http://localhost:3000"
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
# Credenciales del único usuario admin. `npm run db:seed` las lee de acá para
# crear (o actualizar la contraseña de) ese usuario en la base.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Variables de las fases siguientes, todavía no usadas:

# Fase 4 — Mercado Pago Checkout Pro
# MP_ACCESS_TOKEN=""
# MP_PUBLIC_KEY=""
# MP_WEBHOOK_SECRET=""

# Fase 5 — Cloudinary (subida de imágenes de producto desde el admin).
# Creá una cuenta gratis en https://cloudinary.com/users/register/free y copiá
# estos 3 valores del dashboard ("Product Environment Credentials"). Sin esto,
# subir una imagen desde el admin muestra un error explicando qué falta.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
