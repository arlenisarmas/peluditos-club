# Fase 2 — Base de datos (PostgreSQL + Prisma). Requerida.
# Si instalaste PostgreSQL local con winget (ver README), el usuario/contraseña
# por defecto son postgres/postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peluditos_club?schema=public"

# Fase 3 — Autenticación (NextAuth) y usuario admin. Requeridas.
NEXTAUTH_URL="http://localhost:3000"
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
# Credenciales del único usuario admin. `npm run db:seed` las lee de acá para
# crear (o actualizar la contraseña de) ese usuario en la base.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Variables de las fases siguientes, todavía no usadas:

# Fase 4 — Mercado Pago Checkout Pro
# MP_ACCESS_TOKEN=""
# MP_PUBLIC_KEY=""
# MP_WEBHOOK_SECRET=""

# Fase 5 — Cloudinary (imágenes)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
